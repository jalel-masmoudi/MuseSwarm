# Baseten OpenAI-Compatible Inference Endpoint for Meta Muse Spark Open
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
MUSE_MODEL_ID=meta-models/muse-spark-open-1026

# MuseSwarm Server Configuration
PORT=4321
MUSE_SWARM_TPM_LIMIT=2000000

# Hosted public demo: load golden sessions, replay SSE, never call live Baseten
# even if BASETEN_API_KEY is set. POST /api/swarm/run|rework stay offline
# (offline_fixture / deterministic_restore) and are rate-limited.
