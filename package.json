    "demo": "node src/cli.js run --demo",
    "mcp": "node src/mcp-server.js",
    "test": "node src/test-e2e.js",
    "build:ui": "cd museswarm-studio && npm run build",
    "dev:ui": "cd museswarm-studio && npm run dev"
  },
  "keywords": [
