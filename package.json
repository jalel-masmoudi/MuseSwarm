{
  "name": "muse-swarm",
  "version": "1.1.0",
  "description": "MuseSwarm — Multi-Agent Bot-to-Bot Software Engineering Collaboration Engine powered by Meta Muse Spark Open (meta-models/muse-spark-open-1026) on Baseten + Cursor MCP integration",
  "main": "src/index.js",
  "bin": {
    "muse-swarm": "./src/cli.js",
    "muse-code-swarm": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "doctor": "node src/cli.js doctor",
